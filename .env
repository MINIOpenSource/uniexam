# 应用基本配置
APP_DOMAIN=localhost
FRONTEND_DOMAIN="https://ciexam-back.minisvc.com" # 前端应用的访问地址，用于CORS配置
LISTENING_PORT="17071"

# 初始Admin密码 (如果settings.json中未设置或为null，则首次运行时会使用此密码或随机生成)
# 如果不设置此项，且settings.json中也未设置，则首次运行会随机生成一个admin密码并打印到日志
# INITIAL_ADMIN_PASSWORD="supersecretpassword"

# Token密钥 (对于当前基于内存的简单Token不是必需的，但如果将来切换到JWT则需要)
# TOKEN_SECRET_KEY="your_very_strong_and_secret_key_for_jwt_tokens"
INITIAL_ADMIN_PASSWORD=admin
DB_TYPE=sqlite
DB_JSON_PATH=data\/db.json
SQLITE_DB_PATH=data\/sqlite.db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mydb
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_SERVER=localhost
MYSQL_PORT=3306
MYSQL_DB=mydb
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
